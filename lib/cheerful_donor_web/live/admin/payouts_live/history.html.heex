<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-3xl">
    <header class="mb-8 flex items-center justify-between gap-4 border-b-2 border-base-300 pb-6">
      <h1 class="cd-page-title text-3xl">Payout history</h1>
      <.link
        navigate={~p"/admin/payouts"}
        class="text-sm font-bold text-primary hover:underline"
      >
        Back to payouts
      </.link>
    </header>

    <div id="history" class="cd-panel p-5">
      <%= if @payouts == [] do %>
        <p class="cd-muted py-12 text-center font-medium">No payouts yet</p>
      <% else %>
        <div class="cd-table">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left">
                  <th class="px-3 py-3">Date</th>
                  <th class="px-3 py-3">Bank</th>
                  <th class="px-3 py-3">Amount</th>
                  <th class="px-3 py-3">Status</th>
                </tr>
              </thead>
              <tbody>
                <%= for payout <- @payouts do %>
                  <tr>
                    <td class="px-3 py-3 font-medium">{format_datetime(payout.inserted_at)}</td>
                    <td class="px-3 py-3 font-medium">
                      {payout.bank_account.bank_name} ({payout.bank_account.account_number})
                    </td>
                    <td class="px-3 py-3 font-semibold">{format_money(payout.amount)}</td>
                    <td class="px-3 py-3">
                      <span class={status_badge_class(payout.status)}>{payout.status}</span>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.admin>
