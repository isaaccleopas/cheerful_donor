<div id="history" class="mt-10">
    <%= if @payouts == [] do %>

        <p class="text-gray-500">No payouts yet</p>

    <% else %>
    <h2 class="text-xl font-semibold mb-4">Payout History</h2>

    <table class="w-full border rounded">
        <thead class="bg-gray-100 text-left">
        <tr>
            <th class="p-2">Date</th>
            <th class="p-2">Bank</th>
            <th class="p-2">Amount</th>
            <th class="p-2">Status</th>
        </tr>
        </thead>

        <tbody>
        <%= for payout <- @payouts do %>
            <tr class="border-t">
            <td class="p-2">
                <%= Calendar.strftime(payout.inserted_at, "%d %b %Y") %>
            </td>

            <td class="p-2">
                <%= payout.bank_account.bank_name %>
                (<%= payout.bank_account.account_number %>)
            </td>

            <td class="p-2">
                ₦<%= payout.amount %>
            </td>

            <td class="p-2">
                <span class={
                case payout.status do
                    :success -> "text-green-600"
                    :failed -> "text-red-600"
                    :pending -> "text-yellow-600"
                    :processing -> "text-blue-600"
                end
                }>
                <%= payout.status %>
                </span>
            </td>
            </tr>
        <% end %>
        </tbody>
    </table>
  <% end %>
</div>