<Layouts.admin flash={@flash} current_user={@current_user}>
  <%= if @needs_onboarding do %>
    <div class="cd-panel mx-auto mt-12 max-w-xl p-8 text-center">
      <h1 class="cd-page-title text-3xl">Welcome</h1>
      <p class="cd-muted mt-3 font-medium">
        Create your church profile to start accepting donations.
      </p>
      <.link
        navigate={~p"/admin/church/new"}
        class="cd-cta mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 font-semibold text-primary-content hover:brightness-110"
      >
        Create church
      </.link>
    </div>
  <% else %>
    <header class="mb-8 flex flex-col gap-4 border-b-2 border-base-300 pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="cd-page-title text-2xl sm:text-3xl">
          {@church.name}
        </h1>
        <p class="cd-muted mt-1 text-sm font-semibold">Admin dashboard</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <.link
          navigate={~p"/admin/payouts"}
          class="cd-cta inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
        >
          Manage payouts
        </.link>
        <.link
          navigate={~p"/admin/campaigns/new"}
          class="cd-cta inline-flex min-h-11 items-center rounded-lg border-2 border-base-300 bg-base-100 px-4 text-sm font-semibold hover:bg-base-200"
        >
          New campaign
        </.link>
      </div>
    </header>

    <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <.stat label="Total raised" value={format_money(@stats.total_amount)} />
      <.stat label="Donations" value={to_string(@stats.donation_count)} />
      <.stat label="Active campaigns" value={to_string(@stats.active_campaigns)} />
    </div>

    <section class="cd-panel mb-10 p-6">
      <h2 class="cd-section-title mb-4 border-b-2 border-base-300 pb-3">Campaigns</h2>
      <ul class="divide-y-2 divide-base-300">
        <%= for campaign <- @campaigns do %>
          <li class="flex items-center justify-between gap-4 py-4">
            <.link
              navigate={~p"/admin/campaigns/#{campaign.id}"}
              class="font-semibold text-base-content hover:text-primary"
            >
              {campaign.title}
            </.link>
            <span class={[
              "rounded-full px-2.5 py-1 text-xs font-bold",
              campaign.is_active && "bg-success/15 text-success",
              !campaign.is_active && "bg-base-300 text-base-content/70"
            ]}>
              {if(campaign.is_active, do: "Active", else: "Inactive")}
            </span>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="cd-panel p-6">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-2 border-base-300 pb-3">
        <h2 class="cd-section-title">Donations</h2>
        <.link
          patch={
            if(@show_all_donations?,
              do: ~p"/admin/dashboard",
              else: ~p"/admin/dashboard?show_donations=all"
            )
          }
          class="text-sm font-bold text-primary hover:underline"
        >
          {if(@show_all_donations?, do: "Show recent", else: "View all donations")}
        </.link>
      </div>
      <div class="cd-table">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-left">
                <th class="px-3 py-3">Amount</th>
                <th class="px-3 py-3">Campaign</th>
                <th class="px-3 py-3">Status</th>
                <th class="px-3 py-3">Date</th>
              </tr>
            </thead>
            <tbody>
              <%= for donation <- @recent_donations do %>
                <tr>
                  <td class="px-3 py-3 font-semibold">
                    {format_money(donation.amount_paid || donation.amount)}
                  </td>
                  <td class="px-3 py-3">{donation.campaign && donation.campaign.title}</td>
                  <td class="px-3 py-3">
                    <span class={status_badge_class(donation.status)}>{donation.status}</span>
                  </td>
                  <td class="px-3 py-3 font-medium">{format_datetime(donation.inserted_at)}</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  <% end %>
</Layouts.admin>
