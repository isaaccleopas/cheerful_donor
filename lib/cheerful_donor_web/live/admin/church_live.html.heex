<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-xl">
    <h1 class="font-display mb-6 text-2xl font-semibold text-primary">Create church</h1>

    <form id="church-form" phx-submit="save" class="space-y-4">
      <input
        name="church[name]"
        placeholder="Church name"
        required
        class="w-full min-h-11 rounded-lg border border-base-300 bg-base-100 px-4"
      />
      <input
        name="church[email]"
        type="email"
        placeholder="Email"
        class="w-full min-h-11 rounded-lg border border-base-300 bg-base-100 px-4"
      />
      <input
        name="church[phone]"
        placeholder="Phone"
        class="w-full min-h-11 rounded-lg border border-base-300 bg-base-100 px-4"
      />
      <input
        name="church[address]"
        placeholder="Address"
        class="w-full min-h-11 rounded-lg border border-base-300 bg-base-100 px-4"
      />

      <button
        type="submit"
        class="cd-cta w-full min-h-12 rounded-lg bg-primary font-semibold text-primary-content hover:brightness-110"
      >
        Create church
      </button>
    </form>
  </div>
</Layouts.admin>
