<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="cd-form-panel mx-auto max-w-xl">
    <h1 class="cd-page-title mb-6 border-b-2 border-base-300 pb-3 text-2xl">
      {if(@live_action == :edit, do: "Edit campaign", else: "New campaign")}
    </h1>

    <.form
      for={@form}
      id="campaign-form"
      phx-change="validate"
      phx-submit="save"
      class="cd-form"
    >
      <.input field={@form[:id]} type="hidden" />
      <.input field={@form[:title]} label="Title" required />
      <.input field={@form[:description]} label="Description" type="textarea" />
      <.input
        field={@form[:type]}
        type="select"
        label="Type"
        options={[
          {"Campaign", :campaign},
          {"Offering", :offering},
          {"Tithe", :tithe}
        ]}
      />
      <.input field={@form[:goal_amount]} label="Goal amount (optional)" type="number" />
      <.input field={@form[:is_active]} type="checkbox" label="Active?" />
      <div class="cd-form-actions">
        <.link
          navigate={~p"/admin/campaigns"}
          class="inline-flex min-h-11 items-center text-sm font-bold hover:underline"
        >
          Cancel
        </.link>
        <.button class="cd-cta min-h-12 rounded-lg bg-primary px-6 font-semibold text-primary-content hover:brightness-110">
          Save campaign
        </.button>
      </div>
    </.form>
  </div>
</Layouts.admin>
