<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-xl">
    <h1 class="font-display mb-6 text-2xl font-semibold text-primary">
      {if(@live_action == :edit, do: "Edit campaign", else: "New campaign")}
    </h1>

    <.form
      for={@form}
      id="campaign-form"
      phx-change="validate"
      phx-submit="save"
      class="space-y-4"
    >
      <.input field={@form[:id]} type="hidden" />
      <.input field={@form[:title]} label="Title" required class="min-h-11" />
      <.input field={@form[:description]} label="Description" type="textarea" />
      <.input
        field={@form[:type]}
        type="select"
        label="Type"
        options={[
          {"Campaign", :campaign},
          {"Offering", :offering},
          {"Tithe", :tithe}
        ]}
        class="min-h-11"
      />
      <.input
        field={@form[:goal_amount]}
        label="Goal amount (optional)"
        type="number"
        class="min-h-11"
      />
      <.input field={@form[:is_active]} type="checkbox" label="Active?" />
      <.button class="cd-cta min-h-12 w-full rounded-lg bg-primary font-semibold text-primary-content hover:brightness-110">
        Save
      </.button>
    </.form>
  </div>
</Layouts.admin>
