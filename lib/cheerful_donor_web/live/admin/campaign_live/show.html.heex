<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-xl">
    <h1 class="font-display text-3xl font-semibold text-primary">{@campaign.title}</h1>
    <p class="mt-3 text-base-content/70">{@campaign.description}</p>

    <dl class="mt-6 space-y-2 text-sm">
      <div class="flex gap-2">
        <dt class="text-base-content/50">Type</dt>
        <dd>{String.capitalize(to_string(@campaign.type))}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-base-content/50">Status</dt>
        <dd>{if(@campaign.is_active, do: "Active", else: "Inactive")}</dd>
      </div>
    </dl>

    <div class="mt-8 border-t border-base-300 pt-6">
      <h2 class="font-display text-lg font-semibold">Share this link</h2>
      <input
        id="share-link"
        type="text"
        readonly
        value={@share_url}
        class="mt-3 w-full min-h-11 rounded-lg border border-base-300 bg-base-200 px-4 text-sm"
      />
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <.link
        navigate={~p"/admin/campaigns/#{@campaign.id}/edit"}
        class="cd-cta inline-flex min-h-11 items-center rounded-lg border border-base-300 px-4 text-sm font-semibold hover:bg-base-200"
      >
        Edit campaign
      </.link>
      <button
        type="button"
        phx-click="toggle"
        class="cd-cta inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
      >
        {if(@campaign.is_active, do: "Deactivate", else: "Activate")}
      </button>
    </div>
  </div>
</Layouts.admin>
