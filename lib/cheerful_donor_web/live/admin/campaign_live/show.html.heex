<Layouts.admin flash={@flash} current_user={@current_user}>
  <div class="cd-form-panel mx-auto max-w-2xl">
    <h1 class="cd-page-title text-3xl">{@campaign.title}</h1>
    <p class="cd-muted mt-3 font-medium">{@campaign.description}</p>

    <dl class="mt-6 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div class="rounded-xl border-2 border-base-300 bg-base-200/50 p-4">
        <dt class="cd-label">Type</dt>
        <dd class="mt-1 font-semibold">{String.capitalize(to_string(@campaign.type))}</dd>
      </div>
      <div class="rounded-xl border-2 border-base-300 bg-base-200/50 p-4">
        <dt class="cd-label">Status</dt>
        <dd class="mt-2">
          <span class={[
            "rounded-full border px-2.5 py-1 text-xs font-bold",
            @campaign.is_active && "border-success/40 bg-success/15 text-success",
            !@campaign.is_active && "border-base-300 bg-base-200 text-base-content/70"
          ]}>
            {if(@campaign.is_active, do: "Active", else: "Inactive")}
          </span>
        </dd>
      </div>
    </dl>

    <div class="mt-8 border-t-2 border-base-300 pt-6">
      <h2 class="cd-section-title">Share this campaign</h2>
      <p class="cd-muted mt-1 text-sm font-medium">
        Open the donation page or share it on your favorite platforms.
      </p>

      <div class="mt-4 flex flex-col gap-3 sm:flex-row">
        <a
          id="share-link"
          href={@share_url}
          target="_blank"
          rel="noopener noreferrer"
          class="cd-field flex flex-1 items-center truncate font-semibold text-primary hover:underline"
        >
          {@share_url}
        </a>
        <button
          type="button"
          id="copy-share-link"
          phx-hook=".CopyShareLink"
          phx-update="ignore"
          data-copy={@share_url}
          class="cd-cta inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border-2 border-base-300 px-4 text-sm font-bold hover:bg-base-200"
        >
          <.icon name="hero-clipboard-document" class="size-4" />
          {if(@copied?, do: "Copied", else: "Copy link")}
        </button>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <%= for link <- @share_links do %>
          <a
            id={"share-#{link.id}"}
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="cd-cta inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border-2 border-base-300 px-3 text-sm font-bold hover:border-primary hover:bg-primary/5 hover:text-primary"
          >
            <.icon name={link.icon} class="size-4" />
            {link.label}
          </a>
        <% end %>
        <.link
          navigate={~p"/donate/#{@campaign.slug}"}
          class="cd-cta inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-3 text-sm font-bold text-primary-content hover:brightness-110 sm:col-span-3"
        >
          <.icon name="hero-arrow-top-right-on-square" class="size-4" />
          Open donation page
        </.link>
      </div>
    </div>

    <div class="cd-form-actions mt-6">
      <.link
        navigate={~p"/admin/campaigns/#{@campaign.id}/edit"}
        class="cd-cta inline-flex min-h-11 items-center rounded-lg border-2 border-base-300 px-4 text-sm font-semibold hover:bg-base-200"
      >
        Edit campaign
      </.link>
      <button
        type="button"
        phx-click="toggle"
        class="cd-cta inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
      >
        {if(@campaign.is_active, do: "Deactivate", else: "Activate")}
      </button>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyShareLink">
    export default {
      mounted() {
        this.el.addEventListener("click", async () => {
          const text = this.el.dataset.copy
          try {
            await navigator.clipboard.writeText(text)
            this.pushEvent("copied", {})
          } catch (_err) {
            const input = document.createElement("textarea")
            input.value = text
            document.body.appendChild(input)
            input.select()
            document.execCommand("copy")
            document.body.removeChild(input)
            this.pushEvent("copied", {})
          }
        })
      }
    }
  </script>
</Layouts.admin>
