<Layouts.admin flash={@flash} current_user={@current_user}>
  <header class="mb-8 flex flex-col gap-4 border-b-2 border-base-300 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <h1 class="cd-page-title text-3xl">Campaigns</h1>
    <.link
      navigate={~p"/admin/campaigns/new"}
      class="cd-cta inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
    >
      New campaign
    </.link>
  </header>

  <ul class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <%= for campaign <- @campaigns do %>
      <li class="cd-panel p-5">
        <div class="flex items-start justify-between gap-3 border-b-2 border-base-300 pb-3">
          <div>
            <.link
              navigate={~p"/admin/campaigns/#{campaign.id}"}
              class="font-display text-lg font-bold hover:text-primary"
            >
              {campaign.title}
            </.link>
            <p class="cd-label mt-2">
              {String.capitalize(to_string(campaign.type))}
            </p>
          </div>
          <span class={[
            "rounded-full border px-2.5 py-1 text-xs font-bold",
            campaign.is_active && "border-success/40 bg-success/15 text-success",
            !campaign.is_active && "border-base-300 bg-base-200 text-base-content/70"
          ]}>
            {if(campaign.is_active, do: "Active", else: "Inactive")}
          </span>
        </div>
        <p class="cd-muted mt-3 line-clamp-3 text-sm font-medium">{campaign.description}</p>
        <p class="cd-muted mt-3 text-xs font-semibold">
          Created {Calendar.strftime(campaign.inserted_at, "%d %b %Y")}
        </p>
        <div class="mt-4">
          <.link
            navigate={~p"/admin/campaigns/#{campaign.id}/edit"}
            class="text-sm font-bold text-primary hover:underline"
          >
            Edit
          </.link>
        </div>
      </li>
    <% end %>
  </ul>
</Layouts.admin>
