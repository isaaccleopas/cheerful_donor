<Layouts.admin flash={@flash} current_user={@current_user}>
  <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h1 class="font-display text-3xl font-semibold text-primary">Campaigns</h1>
    <.link
      navigate={~p"/admin/campaigns/new"}
      class="cd-cta inline-flex min-h-11 items-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
    >
      New campaign
    </.link>
  </header>

  <ul class="divide-y divide-base-300">
    <%= for campaign <- @campaigns do %>
      <li class="py-5">
        <.link
          navigate={~p"/admin/campaigns/#{campaign.id}"}
          class="font-display text-lg font-semibold hover:text-primary"
        >
          {campaign.title}
        </.link>
        <span class="ml-2 text-xs uppercase tracking-wide text-base-content/50">
          {String.capitalize(to_string(campaign.type))}
        </span>
        <p class="mt-2 text-sm text-base-content/70">{campaign.description}</p>
        <div class="mt-3">
          <.link
            navigate={~p"/admin/campaigns/#{campaign.id}/edit"}
            class="text-sm font-medium text-primary hover:underline"
          >
            Edit
          </.link>
        </div>
      </li>
    <% end %>
  </ul>
</Layouts.admin>
