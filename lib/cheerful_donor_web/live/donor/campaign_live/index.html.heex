<Layouts.donor flash={@flash} current_user={@current_user}>
  <div class="cd-panel mx-auto max-w-6xl p-6">
    <header class="mb-10 max-w-2xl border-b-2 border-base-300 pb-6">
      <h1 class="cd-page-title text-3xl sm:text-4xl">
        Discover campaigns
      </h1>
      <p class="cd-muted mt-2 text-base font-medium">
        Support a cause with a one-time or recurring gift.
      </p>
    </header>

    <%= if Enum.empty?(@campaigns) do %>
      <p class="rounded-2xl border-2 border-dashed border-base-300 bg-base-200/50 px-6 py-16 text-center cd-muted font-medium">
        No active campaigns right now.
      </p>
    <% else %>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <%= for item <- @campaigns do %>
          <li>
            <.campaign_card
              campaign={item.campaign}
              raised={item.raised}
              donor_count={item.donor_count}
              href={~p"/donor/donate/#{item.campaign.slug}"}
            />
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</Layouts.donor>
