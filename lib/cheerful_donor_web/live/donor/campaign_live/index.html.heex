<div class="max-w-6xl mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Active Campaigns</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= for campaign <- @campaigns do %>
      <div class="bg-white p-5 rounded-xl shadow">
        <h2 class="text-xl text-gray-500 font-semibold mb-2">
          <%= campaign.title %>
        </h2>

        <p class="text-gray-600 text-sm mb-3">
          <%= campaign.description %>
        </p>

        <p class="text-xs text-gray-500 mb-4">
          Church: <%= campaign.church && campaign.church.name %>
        </p>

        <a
          href={"/donor/donate/#{campaign.slug}"}
          class="block text-center bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition"
        >
          Donate
        </a>
      </div>
    <% end %>
  </div>
</div>