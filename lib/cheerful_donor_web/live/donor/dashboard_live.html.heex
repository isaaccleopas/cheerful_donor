<Layouts.donor flash={@flash} current_user={@current_user}>
  <header class="mb-8 flex flex-col gap-4 border-b-2 border-base-300 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="cd-page-title text-2xl sm:text-3xl">
        Welcome back
      </h1>
      <p class="cd-muted mt-1 text-sm font-semibold">{@user_email || "Donor"}</p>
    </div>
    <.link
      navigate={~p"/donor/campaigns"}
      class="cd-cta inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
    >
      Explore campaigns
    </.link>
  </header>

  <section class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="cd-panel p-5">
      <div class="cd-label">Total given</div>
      <div class="cd-stat-value mt-2 text-2xl text-base-content sm:text-3xl">
        {format_money(@totals.total_given || 0)}
      </div>
    </div>
    <div class="cd-panel p-5">
      <div class="cd-label">This month</div>
      <div class="cd-stat-value mt-2 text-2xl text-base-content sm:text-3xl">
        {format_money(@totals.this_month || 0)}
      </div>
    </div>
    <div class="cd-panel p-5">
      <div class="cd-label">Subscriptions</div>
      <div class="cd-stat-value mt-2 text-2xl text-base-content sm:text-3xl">
        {length(@subscriptions || [])}
      </div>
    </div>
  </section>

  <nav
    class="mb-6 flex flex-wrap gap-2 rounded-2xl border-2 border-base-300 bg-base-200/60 p-2"
    id="donor-tabs"
  >
    <button
      type="button"
      phx-click="set_tab"
      phx-value-tab="donations"
      class={[
        "min-h-11 rounded-xl px-4 text-sm font-bold transition",
        @tab == "donations" && "bg-primary text-primary-content shadow-sm",
        @tab != "donations" && "text-base-content/80 hover:bg-base-100"
      ]}
    >
      Donations
    </button>
    <button
      type="button"
      phx-click="set_tab"
      phx-value-tab="subscriptions"
      class={[
        "min-h-11 rounded-xl px-4 text-sm font-bold transition",
        @tab == "subscriptions" && "bg-primary text-primary-content shadow-sm",
        @tab != "subscriptions" && "text-base-content/80 hover:bg-base-100"
      ]}
    >
      Subscriptions
    </button>
    <button
      type="button"
      phx-click="set_tab"
      phx-value-tab="transactions"
      class={[
        "min-h-11 rounded-xl px-4 text-sm font-bold transition",
        @tab == "transactions" && "bg-primary text-primary-content shadow-sm",
        @tab != "transactions" && "text-base-content/80 hover:bg-base-100"
      ]}
    >
      Transactions
    </button>
  </nav>

  <section class="cd-panel p-6">
    <%= if @tab == "donations" do %>
      <div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-2 border-base-300 pb-3">
          <h2 class="cd-section-title">Your donations</h2>
          <button
            type="button"
            id="toggle-donations"
            phx-click="toggle_show_all"
            phx-value-section="donations"
            class="text-sm font-bold text-primary hover:underline"
          >
            {if(@show_all_donations?, do: "Show recent", else: "View all")}
          </button>
        </div>
        <%= if Enum.empty?(@donations || []) do %>
          <p class="cd-muted py-10 text-center text-sm font-medium">
            You haven’t made any donations yet.
          </p>
        <% else %>
          <div class="cd-table">
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="text-left">
                    <th class="px-4 py-3">Campaign</th>
                    <th class="px-4 py-3">Amount</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Date</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for d <- visible_items(@donations, @show_all_donations?) do %>
                    <tr>
                      <td class="px-4 py-3 font-semibold">
                        {if(d.campaign, do: d.campaign.title, else: "General")}
                      </td>
                      <td class="px-4 py-3 font-semibold">
                        {format_money(d.amount_paid || d.amount)}
                      </td>
                      <td class="px-4 py-3">
                        <span class={status_label_class(d.status)}>{d.status}</span>
                      </td>
                      <td class="px-4 py-3 font-medium">{format_datetime(d.inserted_at)}</td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @tab == "subscriptions" do %>
      <div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-2 border-base-300 pb-3">
          <h2 class="cd-section-title">Your subscriptions</h2>
          <button
            type="button"
            id="toggle-subscriptions"
            phx-click="toggle_show_all"
            phx-value-section="subscriptions"
            class="text-sm font-bold text-primary hover:underline"
          >
            {if(@show_all_subscriptions?, do: "Show recent", else: "View all")}
          </button>
        </div>
        <%= if Enum.empty?(@subscriptions || []) do %>
          <p class="cd-muted py-10 text-center text-sm font-medium">
            No active subscriptions yet.
          </p>
        <% else %>
          <div class="cd-table">
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="text-left">
                    <th class="px-4 py-3">Amount</th>
                    <th class="px-4 py-3">Interval</th>
                    <th class="px-4 py-3">Next charge</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3"></th>
                  </tr>
                </thead>
                <tbody>
                  <%= for s <- visible_items(@subscriptions, @show_all_subscriptions?) do %>
                    <tr>
                      <td class="px-4 py-3 font-semibold">{format_money(s.amount)}</td>
                      <td class="px-4 py-3 font-medium">{s.interval}</td>
                      <td class="px-4 py-3 font-medium">
                        {if(s.next_charge_at, do: format_datetime(s.next_charge_at), else: "—")}
                      </td>
                      <td class="px-4 py-3">
                        <span class={status_label_class(s.status)}>{s.status}</span>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <%= if s.status == :active do %>
                          <button
                            type="button"
                            id={"cancel-subscription-#{s.id}"}
                            phx-click="cancel_subscription"
                            phx-value-id={s.id}
                            data-confirm="Cancel this subscription?"
                            class="min-h-9 rounded-lg border-2 border-error/50 bg-error/10 px-3 text-xs font-bold text-error hover:bg-error/20"
                          >
                            Cancel subscription
                          </button>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @tab == "transactions" do %>
      <div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b-2 border-base-300 pb-3">
          <h2 class="cd-section-title">Your transactions</h2>
          <button
            type="button"
            id="toggle-transactions"
            phx-click="toggle_show_all"
            phx-value-section="transactions"
            class="text-sm font-bold text-primary hover:underline"
          >
            {if(@show_all_transactions?, do: "Show recent", else: "View all")}
          </button>
        </div>
        <%= if Enum.empty?(@transactions || []) do %>
          <p class="cd-muted py-10 text-center text-sm font-medium">No transactions yet.</p>
        <% else %>
          <div class="cd-table">
            <div class="overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead>
                  <tr class="text-left">
                    <th class="px-4 py-3">Amount</th>
                    <th class="px-4 py-3">Type</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Date</th>
                  </tr>
                </thead>
                <tbody>
                  <%= for t <- visible_items(@transactions, @show_all_transactions?) do %>
                    <tr>
                      <td class="px-4 py-3 font-semibold">{format_money(t.amount)}</td>
                      <td class="px-4 py-3 font-medium">
                        <%= cond do %>
                          <% t.donation_id -> %>
                            Donation
                          <% t.subscription_id -> %>
                            Subscription
                          <% true -> %>
                            Other
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <span class={status_label_class(t.status)}>{t.status}</span>
                      </td>
                      <td class="px-4 py-3 font-medium">
                        {format_datetime(t.paid_at || t.inserted_at)}
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</Layouts.donor>
