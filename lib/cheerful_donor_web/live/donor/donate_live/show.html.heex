<Layouts.donor flash={@flash} current_user={@current_user}>
  <div class="cd-panel mx-auto max-w-6xl p-6">
    <.link
      navigate={~p"/donor/campaigns"}
      class="text-sm font-bold text-primary hover:underline"
    >
      ← All campaigns
    </.link>

    <div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="lg:col-span-3">
        <p class="cd-muted text-sm font-semibold">
          Donating as
          <span class="font-bold text-base-content">{@donor.user && @donor.user.email}</span>
        </p>
        <h1 class="font-display mt-2 text-3xl font-bold tracking-tight text-base-content sm:text-4xl">
          {@campaign.title}
        </h1>
        <p class="cd-label mt-2">
          {@campaign.church && @campaign.church.name}
        </p>

        <div class="cd-panel mt-6 p-6">
          <.campaign_progress
            raised={@stats.raised}
            goal={@campaign.goal_amount}
            donor_count={@stats.donor_count}
          />
        </div>

        <div class="mt-6 border-t-2 border-base-300 pt-6">
          <h2 class="cd-section-title">About this fundraiser</h2>
          <p class="cd-muted mt-3 text-base font-medium leading-relaxed">{@campaign.description}</p>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="cd-form-panel lg:sticky lg:top-24 shadow-lg">
          <h2 class="cd-section-title border-b-2 border-base-300 pb-3">Enter your donation</h2>

          <form id="donor-donate-form" phx-submit="start_payment" class="cd-form mt-6">
            <fieldset class="rounded-xl border-2 border-base-300 p-4">
              <legend class="cd-field-label px-1">Donation type</legend>
              <div class="flex flex-wrap gap-3">
                <label class="flex min-h-11 items-center gap-2 rounded-xl border-2 border-base-300 px-4 text-sm font-semibold has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                  <input
                    type="radio"
                    name="donation_type"
                    value="one_time"
                    checked={@donation_type == :one_time}
                    phx-change="set_donation_type"
                    class="radio radio-primary border-2"
                  /> One time
                </label>
                <label class="flex min-h-11 items-center gap-2 rounded-xl border-2 border-base-300 px-4 text-sm font-semibold has-[:checked]:border-primary has-[:checked]:bg-primary/5">
                  <input
                    type="radio"
                    name="donation_type"
                    value="recurring"
                    checked={@donation_type == :recurring}
                    phx-change="set_donation_type"
                    class="radio radio-primary border-2"
                  /> Recurring
                </label>
              </div>
            </fieldset>

            <%= if @donation_type == :recurring do %>
              <div>
                <label for="interval" class="cd-field-label">Interval</label>
                <select
                  id="interval"
                  name="interval"
                  phx-change="set_interval"
                  class="cd-field"
                >
                  <%= for interval <- [:daily, :weekly, :monthly, :quarterly, :annually] do %>
                    <option value={interval} selected={@interval == interval}>
                      {String.capitalize(to_string(interval))}
                    </option>
                  <% end %>
                </select>
              </div>
            <% end %>

            <div>
              <label class="cd-field-label">Quick amounts</label>
              <.amount_picker selected={@amount} />
            </div>

            <div>
              <label for="amount" class="cd-field-label">Amount (₦)</label>
              <input
                id="amount"
                type="number"
                name="amount"
                value={@amount}
                phx-change="set_amount"
                phx-debounce="500"
                placeholder="5000"
                min="100"
                class="cd-field"
              />
            </div>

            <button
              type="submit"
              class="cd-cta w-full min-h-12 rounded-xl bg-primary text-base font-semibold text-primary-content hover:brightness-110"
            >
              Donate now
            </button>
          </form>

          <div class="mt-6 border-t-2 border-base-300 pt-4">
            <.trust_strip />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layouts.donor>
