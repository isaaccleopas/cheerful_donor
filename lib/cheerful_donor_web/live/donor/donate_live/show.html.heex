<div class="max-w-4xl mx-auto p-6">
    <div class="bg-white shadow-xl rounded-2xl p-8">
      <p class="text-gray-700 text-center">
        Donating as:
        <span class="font-semibold"><%= @donor.user && @donor.user.email %></span>
      </p>
      <h1 class="text-3xl text-gray-500 font-bold mb-2">
        <%= @campaign.title %>
      </h1>

      <p class="text-gray-500 text-sm mb-4">
        Church: <%= @campaign.church && @campaign.church.name %>
      </p>

      <p class="text-gray-700 mb-6">
        <%= @campaign.description %>
      </p>

      <%= if @campaign.goal_amount do %>
        <div class="mb-6">
          <p class="text-sm text-gray-500 mb-1">
            Goal: ₦<%= @campaign.goal_amount %>
          </p>

          <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-indigo-600 h-3 rounded-full" style="width: 0%"></div>
          </div>
        </div>
      <% end %>

      <div class="border-t pt-6">
        <h2 class="text-xl font-semibold mb-4 text-gray-500">Make a Donation</h2>

        <form phx-submit="start_payment">
          <div class="mb-6">
            <label class="block mb-2 text-gray-700 font-medium">Donation Type</label>
            <div class="flex gap-4 text-gray-700">
              <label>
                <input
                  type="radio"
                  name="donation_type"
                  value="one_time"
                  checked={@donation_type == :one_time}
                  phx-change="set_donation_type"
                />
                One Time
              </label>
              <label>
                <input
                  type="radio"
                  name="donation_type"
                  value="recurring"
                  checked={@donation_type == :recurring}
                  phx-change="set_donation_type"
                />
                Recurring
              </label>
            </div>
          </div>

          <%= if @donation_type == :recurring do %>
            <div class="mb-6">
              <label class="block mb-2 text-gray-700 font-medium">Interval</label>
              <select name="interval" phx-change="set_interval" class="w-full px-4 py-3 border rounded-lg text-gray-500">
                <%= for interval <- [:daily, :weekly, :monthly, :quarterly, :annually] do %>
                  <option value={interval}><%= String.capitalize(to_string(interval)) %></option>
                <% end %>
              </select>
            </div>
          <% end %>

          <input
            type="number"
            name="amount"
            value={@amount}
            phx-change="set_amount"
            phx-debounce="500"
            placeholder="Enter amount"
            class="w-full px-4 py-3 border rounded-lg text-gray-500"
          />

          <button type="submit" class="w-full mt-6 py-3 bg-indigo-600 text-white rounded-lg">
            Donate Now
          </button>
        </form>
      </div>

    </div>
</div>