<Layouts.marketing flash={@flash} current_user={@current_user}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10 max-w-2xl">
      <h1 class="font-display text-3xl font-semibold tracking-tight text-primary sm:text-4xl">
        Active campaigns
      </h1>
      <p class="mt-2 text-base text-base-content/70">
        Choose a campaign and give in a few steps.
      </p>
    </header>

    <%= if Enum.empty?(@campaigns) do %>
      <p class="rounded-xl border border-dashed border-base-300 bg-base-200/50 px-6 py-16 text-center text-base-content/60">
        No active campaigns right now. Check back soon.
      </p>
    <% else %>
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <%= for campaign <- @campaigns do %>
          <li class="flex flex-col border-b border-base-300 pb-8">
            <h2 class="font-display text-xl font-semibold text-base-content">
              {campaign.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-base-content/70">
              {campaign.description}
            </p>
            <p class="mt-3 text-xs uppercase tracking-wide text-base-content/50">
              {campaign.church && campaign.church.name}
            </p>
            <.link
              navigate={~p"/donate/#{campaign.slug}"}
              class="cd-cta mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-semibold text-primary-content hover:brightness-110"
            >
              Donate
            </.link>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</Layouts.marketing>
