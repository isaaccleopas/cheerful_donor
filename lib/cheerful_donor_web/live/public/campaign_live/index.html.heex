<Layouts.marketing flash={@flash} current_user={@current_user}>
  <div class="bg-base-200/40">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <header class="mx-auto max-w-2xl border-b-2 border-base-300 pb-8 text-center">
        <h1 class="font-display text-3xl font-bold tracking-tight text-base-content sm:text-4xl">
          Discover fundraisers
        </h1>
        <p class="cd-muted mt-3 text-base font-medium">
          Every campaign has a story. Find one that moves you and give today.
        </p>
      </header>

      <%= if Enum.empty?(@campaigns) do %>
        <p class="cd-panel mx-auto mt-12 max-w-md border-dashed px-6 py-16 text-center cd-muted font-medium">
          No active campaigns right now. Check back soon.
        </p>
      <% else %>
        <ul class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <%= for item <- @campaigns do %>
            <li>
              <.campaign_card
                campaign={item.campaign}
                raised={item.raised}
                donor_count={item.donor_count}
                href={~p"/donate/#{item.campaign.slug}"}
              />
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</Layouts.marketing>
